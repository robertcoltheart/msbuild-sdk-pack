<Project>

  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeProjectReferencesInPackage</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="IncludeProjectReferencesInPackage" Returns="@(TfmSpecificPackageFile)">

    <ItemGroup>
      <_PackProjectReference Include="@(ProjectReference->WithMetadataValue('Pack', 'true'))" />
    </ItemGroup>

    <ItemGroup>
      <_PackProjectReference Update="@(_PackProjectReference.PackAsAnalyzer)">
        <PackagePath Condition="'%(_PackProjectReference.PackagePath)' == ''">lib/$(TargetFramework)</PackagePath>
      </_PackProjectReference>
    </ItemGroup>

    <MSBuild Projects="@(MSBuildProjectFullPath)"
             Targets="_GetSingleProjectReferencePackageFile"
             Properties="_ProjectReferencePath=%(_PackProjectReference.Identity);_ProjectReferencePackagePathValue=%(_PackProjectReference.PackagePath);_ProjectReferenceSetTargetFramework=%(_PackProjectReference.SetTargetFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="TfmSpecificPackageFile" />
    </MSBuild>
  </Target>

  <Target Name="_GetSingleProjectReferencePackageFile" Returns="@(TfmSpecificPackageFile)">

    <MSBuild Projects="$(_ProjectReferencePath)"
             Targets="BuiltProjectOutputGroup;DocumentationProjectOutputGroup"
             Properties="$(_ProjectReferenceSetTargetFramework)"
             RemoveProperties="TargetFramework">
      <Output TaskParameter="TargetOutputs" ItemName="_ProjectReferenceTargetPath" />
    </MSBuild>

    <ItemGroup>
      <TfmSpecificPackageFile Include="@(_ProjectReferenceTargetPath)" PackagePath="$(_ProjectReferencePackagePathValue)" />
    </ItemGroup>
  </Target>

</Project>
